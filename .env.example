# ==============================================================================
# Зразок конфігурації для локального запуску та деплою на Render / Docker
# Скопіюйте у .env локально або додайте ці змінні в Render Dashboard -> Environment
# ==============================================================================

# ── Безпека та Flask ──────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
PORT=10000
DATABASE_PATH=school.db
SCHOOL_NAME=Ужгородський ліцей №3

# ── Пароль головного супер-адміністратора (gmedvedev) ──────────────────────────
# За замовчуванням логін: gmedvedev
SUPERUSER_PASSWORD=gmedvedev123

# ── Telegram бот (Ужгородський ліцей №3 @MedelnBot) ──────────────────────────
# Отримати токен: @BotFather в Telegram -> /newbot
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=MedelnBot
# Ваш особистий Telegram ID (можна дізнатися в @userinfobot):
ADMIN_TELEGRAM_ID=513546547

# ── Штучний інтелект (генерація тестів, матеріалів, завдань) ──────────────────
# Отримати безкоштовно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Fallback провайдери AI (опційно) ──────────────────────────────────────────
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY_1=
# Groq: https://console.groq.com/keys
GROQ_API_KEY_1=
