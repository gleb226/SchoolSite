# ═══════════════════════════════════════════════════════════════════════════
# SchoolSite — конфігурація (.env.example)
# Скопіюй у .env і заповни значення. НЕ комітити .env в git!
# ═══════════════════════════════════════════════════════════════════════════

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=змінити-на-довгий-випадковий-рядок-мінімум-32-символи
FLASK_ENV=production
FLASK_DEBUG=0
DATABASE_PATH=school.db
PORT=5000

# ── Назва школи ───────────────────────────────────────────────────────────────
SCHOOL_NAME=Назва вашої школи

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. Напишіть @BotFather в Telegram
# 2. /newbot → дайте ім'я → отримайте токен
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Ваш Telegram user ID (напишіть @userinfobot → "Id:")
ADMIN_TELEGRAM_ID=123456789

# ── Google Gemini API (БЕЗКОШТОВНО — рекомендується для укр. мови) ───────────
# Отримати: https://aistudio.google.com/app/apikey
# Ліміт безкоштовного плану: 15 req/хв, 1500 req/день (на 1 ключ)
# До 5 ключів для збільшення ліміту:
GEMINI_API_KEY=AIzaSy...ваш-ключ-тут
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b
GEMINI_RETRIES=2
GEMINI_TIMEOUT_SECONDS=90

# ── OpenRouter API (БЕЗКОШТОВНО — fallback для довгих матеріалів) ─────────────
# Отримати: https://openrouter.ai → Dashboard → Keys
# Безкоштовні моделі позначені :free — ліміт 20-200 req/хв залежно від моделі
# До 5 ключів:
OPENROUTER_API_KEY_1=sk-or-v1-...
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Моделі в порядку пріоритету (перші безкоштовні):
OPENROUTER_MODELS=google/gemini-2.0-flash-exp:free,google/gemini-flash-1.5,meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free

# ── Groq API (БЕЗКОШТОВНО — дуже швидкий inference) ──────────────────────────
# Отримати: https://console.groq.com → API Keys
# Ліміт: 6000 токенів/хв безкоштовно
# До 5 ключів:
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-70b-versatile,mixtral-8x7b-32768,gemma2-9b-it

# ── LLM загальні налаштування ─────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=90
LLM_RETRIES=2

# ── Google Custom Search (пошук зображень для тестових питань) ────────────────
# Безкоштовно 100 req/день: https://programmablesearchengine.google.com
# API key: https://console.cloud.google.com → Custom Search API
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── MongoDB (майбутня міграція, зараз SQLite) ─────────────────────────────────
# Безкоштовно: https://www.mongodb.com/cloud/atlas (512MB free tier)
# Встанови MONGO_ENABLED=true після налаштування URI
MONGO_ENABLED=false
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/schoolsite?retryWrites=true
MONGO_DB_NAME=schoolsite
