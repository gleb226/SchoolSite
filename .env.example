# ── Копіюй цей файл в .env та заповни значення ──────────────────────────────
# cp .env.example .env

# Flask
SECRET_KEY=змініть-на-довгий-випадковий-рядок
FLASK_ENV=development
FLASK_DEBUG=0
DATABASE_PATH=school.db
PORT=5000

# Google Gemini AI (отримати на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=ваш-gemini-api-ключ
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b
GEMINI_RETRIES=2
GEMINI_TIMEOUT_SECONDS=90

# Telegram Bot (необов'язково — від @BotFather)
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Google Custom Search (для пошуку зображень до питань — необов'язково)
# Отримати на: https://programmablesearchengine.google.com/
# API key: https://console.cloud.google.com/ → Custom Search API
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
